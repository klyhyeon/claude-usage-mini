<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (the tray icon) lives in WinForms; WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClaudeUsageMini</AssemblyName>
    <RootNamespace>ClaudeUsageMini</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects a global `using System.Drawing`, which collides
         with System.Windows.Media (Brush, Color) in the WPF views. Drop the
         global one; App.xaml.cs keeps a file-scoped using for the tray bitmap. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
