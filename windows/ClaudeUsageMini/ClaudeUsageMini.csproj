<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (the tray icon) lives in WinForms; WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClaudeUsageMini</AssemblyName>
    <RootNamespace>ClaudeUsageMini</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms injects global usings for System.Drawing and
         System.Windows.Forms, which collide with System.Windows.Media / .Controls
         (Brush, Color, Button, Orientation) throughout the WPF views. Drop both
         globals; the two files that genuinely use WinForms (App.xaml.cs,
         CookieJar's HiddenHost) import them with file-scoped usings instead. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
